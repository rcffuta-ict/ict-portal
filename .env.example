# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. That is the only file local development reads
# (Next.js loads .env.local in `pnpm dev`, and it overrides everything else).
#
# Six variables, two of them required. Everything the code actually reads is
# here; if you find a variable named in a doc but missing from this file, the doc
# is out of date.
#
# The deployed site does NOT read any .env file -- Vercel holds its own
# environment variables. .env.production exists locally only so the scripts in
# scripts/ can deliberately target the production project.
#
# Never commit a filled-in copy. .gitignore covers .env*, and this template is
# the one exception.
# ---------------------------------------------------------------------------

# REQUIRED. The Supabase project this environment talks to. For local work that
# is the staging project, not production.
# Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED. Service role key. It BYPASSES ROW LEVEL SECURITY completely: every
# table in this database has RLS enabled and FORCED with no policies, so this key
# is the only way in and there is no second line of defence behind it.
#
# Server-side only. Never import src/lib/db.ts into a client component, and never
# prefix this with NEXT_PUBLIC_ -- that would ship the key to every visitor's
# browser.
# Dashboard -> Project Settings -> API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED in production, and you want it set locally too.
#
# The pepper for scrypt password hashing and session tokens. It is not a Supabase
# value -- generate one: `openssl rand -hex 32`
#
# Changing it invalidates every password and every session in that project at
# once. Use a DIFFERENT secret per project: they are separate databases, and a
# shared pepper means a staging leak helps attack production's hashes.
SESSION_SECRET=

# Which project is production.
#
# scripts/lib/cli.mjs reads this from whichever env file declares it, and marks
# any environment whose URL matches as PRODUCTION -- shown in red, and requiring
# you to type the project ref before a destructive script will run. Without it
# that guard falls back to matching the filename alone, which is the weaker
# signal. Set it in EVERY env file, including the ones that are not production.
PRODUCTION_SUPABASE_URL=https://your-production-ref.supabase.co

# OPTIONAL. Unsigned Cloudinary upload preset for profile photos and the
# coronation banner and icon (uploaded, or imported from a pasted link). Leaving
# these empty disables image upload and breaks nothing else. Both are NEXT_PUBLIC_
# because the browser performs the upload directly -- an unsigned preset is
# designed to be public, so there is no API secret here and the portal does not
# need one. NEXT_PUBLIC_ values are baked in at BUILD time: restart `pnpm dev`, or
# redeploy on Vercel, after changing them.
#
# The preset is public, so restrict it in Cloudinary (Settings -> Upload -> Upload
# presets): Signing mode "Unsigned", an asset folder (e.g. rcf-portal), allowed
# formats jpg,png,webp (no svg: it can carry script), and an incoming transformation of
# c_limit,w_2400,h_2400 so an oversized image is never stored at full size.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Deliberately NOT here
#
#   SUPABASE_ANON_KEY   nothing reads it. Supabase Auth is retired; the portal
#                       authenticates against profile_login + auth_sessions and
#                       reaches the database only through the service role.
#   GITHUB_TOKEN        was needed to install the private @rcffuta/ict-lib
#                       package. That SDK is gone and the lockfile has no
#                       reference to it; `pnpm install` works with no token.
#   CLOUDINARY_API_KEY  server-side signed uploads were never implemented.
#   CLOUDINARY_API_SECRET
#   AUTH_BOOTSTRAP_EMAIL  scripts/bootstrap-admin.mjs takes the email as an
#                         argument instead.
# ---------------------------------------------------------------------------
