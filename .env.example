# =============================================================================
# RCF FUTA ICT Portal — environment template
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit real secrets.
#
# SECURITY RULE: only URLs, the Supabase anon key, and the Cloudinary cloud name
# / upload preset may be prefixed with NEXT_PUBLIC_ (that ships them to the
# browser). Everything else is server-only.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Read by @rcffuta/ict-lib: fromEnv() uses URL + ANON_KEY; asAdmin() uses
# SERVICE_ROLE_KEY. The service-role key BYPASSES RLS — server-only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by a few server actions that construct a QAService directly.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# --- Auth ---------------------------------------------------------------------
# Pepper for scrypt password hashing + session token hardening. REQUIRED in prod.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Email of the first VP Admin to bootstrap (see db/migrations/0001_auth_rework.sql).
AUTH_BOOTSTRAP_EMAIL=

# --- Email (Zoho SMTP only) ---------------------------------------------------
# Server-only credentials — do NOT create NEXT_PUBLIC_ copies.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=noreply@example.com
ZOHO_SMTP_PASS=
ZOHO_SMTP_SENDER_NAME="RCF FUTA ICT"

# --- Cloudinary (optional profile pictures) -----------------------------------
# Client uploads use an UNSIGNED preset. Leave blank to disable photo uploads
# gracefully (the UI shows "photo uploads aren't set up — you can skip this").
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Build-time ---------------------------------------------------------------
# GitHub Packages token for the private @rcffuta/ict-lib (see .npmrc).
GITHUB_TOKEN=
