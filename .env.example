# =============================================================================
# RCF FUTA ICT Portal — environment template
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit real secrets.
#
# SECURITY RULE: only URLs and the Cloudinary cloud name / upload preset may be
# prefixed with NEXT_PUBLIC_ (that prefix ships the value to the browser).
# Everything else is server-only. The service-role key must NEVER carry it.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
# The portal talks to Postgres through the SERVICE-ROLE client only (src/lib/db.ts).
# That key BYPASSES RLS by design: every table is RLS-forced with no policies
# (migration 0001), so the anon key can read nothing, and authorization is enforced
# in server actions via src/lib/access-control.ts.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias. src/lib/db.ts accepts the URL under either name, because both
# were in use historically. Set one or the other; you do not need both.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# --- Auth (required) ----------------------------------------------------------
# Pepper for scrypt password hashing + session-token hardening. Changing it
# invalidates every existing password and session, so set it once and keep it.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Safety rail for the scripts ----------------------------------------------
# The production project's URL. scripts/seed-test.mjs refuses to run against it,
# and the environment picker in scripts/lib/cli.mjs marks it in red and demands
# you type the project ref. Without this, that check falls back to matching the
# FILENAME only (.env.production), which is weaker. Set it in every env file.
PRODUCTION_SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT.supabase.co

# --- Cloudinary (optional — profile pictures) ---------------------------------
# Client uploads use an UNSIGNED preset, so no API secret is needed. Leave blank
# to disable photo uploads gracefully (the UI says so and lets members skip it).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
